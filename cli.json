{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "none",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "animations": true,
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 4
  },
  "terminal": {
    "title": false
  },
  "debug": {
    "devtools": false
  }
}
