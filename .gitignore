# Secrets. service.json holds a plaintext password, so it must never be tracked.
# The copy already sitting in history still needs a purge; ignore rules alone
# only stop new changes from being staged.
service.json

# Plan files are working notes for one session, not project history. `**/` keeps
# the rule working when a session opens inside a monorepo subpackage. Only this
# subtree is ignored: `.opencode/` itself holds real project configuration.
**/.opencode/plan/
